# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma generated client
/src/generated/prisma

# local file storage (attachments, generated reports)
/storage

# local smoke/e2e scripts (not part of the app)
/smoke*.mjs
/test-*.mjs

# local agent skill docs (not part of the app)
/.agents

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# misc project meta not needed in repo
/skills-lock.json
/CLAUDE.md
/AGENTS.md
