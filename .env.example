# ---------------------------------------------------------------------------
# MarketinCrew SEO Command Center — environment variables (LOCAL DEV)
# Copy .env.example -> .env and fill in real values for your environment.
# NEVER commit secrets. This file is gitignored.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Local PostgreSQL (see docker-compose.yml or Homebrew postgresql@17).
# Replace USER:PASSWORD with your own local credentials.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/marketincrew_seo?schema=public"

# --- App --------------------------------------------------------------------
# Generate a strong secret with: openssl rand -base64 32
AUTH_SECRET="generate-a-long-random-string-here"
NEXT_PUBLIC_APP_NAME="MarketinCrew SEO Command Center"
NODE_ENV="development"

# --- Auth / Security --------------------------------------------------------
# Session cookie lifetime in seconds (7 days)
SESSION_MAX_AGE="604800"

# --- Object storage (S3-compatible) -----------------------------------------
# Used for attachments, client logos and generated reports.
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# When empty, local disk storage is used under ./storage
STORAGE_DRIVER="local"

# --- Email ------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="MarketinCrew <noreply@marketincrew.example>"

# --- Redis (queues / cache / rate limiting) ---------------------------------
# Optional in MVP. When empty, in-process task runner is used.
REDIS_URL=""

# --- Feature flags ----------------------------------------------------------
FEATURE_GOOGLE_SEARCH_CONSOLE="false"
FEATURE_GA4="false"
FEATURE_PAGESPEED="false"
FEATURE_AI_INSIGHTS="false"
FEATURE_CLIENT_PORTAL="false"

# --- Integration credentials (Phase 2+) -------------------------------------
# Leave empty to use CSV import / manual entry / demo provider.
#
# Google Search Console + GA4 (OAuth):
# 1. Create an OAuth client at https://console.cloud.google.com/apis/credentials
# 2. Enable the "Google Search Console API" + "Google Analytics Data API".
# 3. Add an Authorized redirect URI:  http://localhost:3000/api/integrations/google/callback
#    (or your production URL /api/integrations/google/callback)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# The public base URL of your app (used to build the OAuth redirect URI).
GOOGLE_REDIRECT_BASE="http://localhost:3000"

# Ahrefs (token-based live API — requires a paid Ahrefs plan). Without it, use
# the "Import Ahrefs CSV" button on each client's Backlinks tab.
AHREFS_API_TOKEN=""

# DataForSEO (rank tracking) — leave empty to use CSV import.
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""
